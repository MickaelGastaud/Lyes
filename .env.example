# Copier ce fichier en .env puis adapter les valeurs.

# Base PostgreSQL. Sur Vercel, la base reliée (onglet Storage) remplit cette variable toute seule.
# En local : une base PostgreSQL sur ta machine, ou la même base que sur Vercel.
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/confiauto"

# Accès au back-office /admin (obligatoire en production)
ADMIN_USER="admin"
ADMIN_PASSWORD="changez-moi"
