# Copier ce fichier en .env puis adapter les valeurs.

# Base PostgreSQL. Sur Vercel, l'intégration Neon remplit ces deux variables toute seule.
# En local : une base PostgreSQL sur ta machine, ou la même base Neon (mêmes valeurs).
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/confiauto"
DATABASE_URL_UNPOOLED="postgresql://utilisateur:motdepasse@localhost:5432/confiauto"

# Accès au back-office /admin (obligatoire en production)
ADMIN_USER="admin"
ADMIN_PASSWORD="changez-moi"
